# Supabase (publishable/anon — safe for client-side use with RLS)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# This repository is the standalone merchant application.
VITE_MERCHANT_STANDALONE="true"
VITE_MERCHANT_DOMAIN_ENABLED="true"
VITE_MERCHANT_ORIGIN="https://merchant.paysme.site"
VITE_PUBLIC_ORIGIN="https://www.paysme.site"
# Edge Functions only: merchant email links (public checkout keeps PUBLIC_SITE_URL).
MERCHANT_PORTAL_URL="https://merchant.paysme.site"

# Optional QR Basket App landing/store URL or paysme-qrbasket:// native link.
# Leave unset until the Basket App is distributed.
VITE_QR_BASKET_APP_URL="https://basket.paysme.site/"

# Optional privacy-consented website analytics.
# Create these properties under support@paysme.site and set the production values in Vercel.
VITE_GA_MEASUREMENT_ID=""
VITE_META_PIXEL_ID=""
VITE_TWIPLA_SITE_ID=""

# WayaMe provider service (server-side Supabase Edge Function secrets only).
# Use non-production test values while WAYAME_MODE=simulation. Replace them with
# sponsor-issued values when onboarding is complete. Never expose these as VITE_ variables.
WAYAME_MODE="simulation"
WAYAME_SPONSOR_NAME="Test Participating Sponsor"
WAYAME_API_BASE_URL="https://sandbox.sponsor.example"
WAYAME_PARTNER_ID="TEST_PAYSME_PARTNER_ID"
WAYAME_AGGREGATOR_ID="TEST_PAYSME_AGGREGATOR_ID"
WAYAME_CLIENT_ID="TEST_PAYSME_CLIENT_ID"
WAYAME_CLIENT_SECRET="replace-with-test-client-secret"
WAYAME_API_KEY="replace-with-test-api-key"
WAYAME_WEBHOOK_SECRET="replace-with-test-webhook-secret"
WAYAME_MERCHANT_VERIFY_ROUTE="v1/wayame/merchants/verify"
WAYAME_PAYMENT_REQUEST_ROUTE="v1/wayame/payments"
WAYAME_PAYMENT_STATUS_ROUTE="v1/wayame/payments/{requestId}/status"
WAYAME_PAYMENT_CANCEL_ROUTE="v1/wayame/payments/{requestId}/cancel"
